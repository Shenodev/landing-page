EXPO_PUBLIC_API_URL=http://localhost:5000
# Calendly scheduling link - set your REAL event type URL once you create it in Calendly
# (e.g. https://calendly.com/YOUR_USERNAME/your-event-type). Leave unset and the
# discovery screen shows a "scheduling link not configured" notice instead.
# EXPO_PUBLIC_CALENDLY_URL=https://calendly.com/YOUR_USERNAME/your-event-type
# For device testing on LAN: EXPO_PUBLIC_API_URL=http://192.168.1.10:5000
# Production (pending DNS shenodev.tech):
# EXPO_PUBLIC_API_URL=https://api.shenodev.dpdns.org
# EXPO_PUBLIC_CALENDLY_URL=https://calendly.com/YOUR_USERNAME/your-event-type