PORT=5000
# Render will inject PORT automatically - do not hardcode in production (uses process.env.PORT)
MONGODB_URI=mongodb://localhost:27017/shenodev
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,https://shenodev.tech
FRONTEND_URL=http://localhost:3000
# In production (Vercel): FRONTEND_URL=https://shenodev.tech
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=hello@contact.shenodev.dpdns.org
ADMIN_EMAIL=admin@contact.shenodev.dpdns.org
ADMIN_SECRET=your-strong-admin-secret-here
# Generate with: openssl rand -hex 32
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# For local file uploads, Cloudinary will store in folders:
# - Projects: shenodev_projects
# - Discovery attachments: shenodev_discovery
# Frontend FormData usage (see instructions below):
# const formData = new FormData();
# formData.append('image', file); // for POST /api/projects - field name "image" (or "file")
# formData.append('title', 'My Project'); // other fields as text
# # For discovery with file:
# formData.append('attachment', file); // field "attachment" or "file" - will be uploaded to shenodev_discovery
#
# ---- Calendly (server-side integration) ----
# CALENDLY_URL is the PUBLIC scheduling link matching your real Calendly event type
# (also set NEXT_PUBLIC_CALENDLY_URL / EXPO_PUBLIC_CALENDLY_URL on the frontends).
# CALENDLY_URL=https://calendly.com/YOUR_USERNAME/your-event-type
#
# Personal Access Token (Calendly -> Integrations -> API & Webhooks). Used to fetch
# authoritative start/end times AND the actual Google Meet link
# (resource.location.join_url) that is injected into the confirmation email.
# CALENDLY_PERSONAL_TOKEN=cal_your_personal_access_token_here
# Legacy alias, still supported:
# CALENDLY_API_TOKEN=cal_your_personal_access_token_here
#
# Signing key of the Calendly webhook subscription pointing at
# https://<your-api-domain>/api/calendly/webhook (events: invitee.created, invitee.canceled).
# Provide your own signing_key when creating the subscription and store it here.
# CALENDLY_WEBHOOK_SIGNING_KEY=your_webhook_signing_key_here
#
# Optional: your Calendly organization URI to filter events (https://api.calendly.com/organizations/XXXXX).
# CALENDLY_ORG_URI=https://api.calendly.com/organizations/XXXXXXXX
# Production (Vercel -> project Settings -> Environment Variables):
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/shenodev?retryWrites=true&w=majority
# NODE_ENV=production
# ALLOWED_ORIGINS=https://shenodev.dpdns.org
# FRONTEND_URL=https://shenodev.dpdns.org
# ADMIN_SECRET=<random, >=32 chars: openssl rand -hex 32>
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=hello@contact.shenodev.dpdns.org
# ADMIN_EMAIL=admin@contact.shenodev.dpdns.org
# CLOUDINARY_CLOUD_NAME=<your_cloud_name>
# CLOUDINARY_API_KEY=<your_api_key>
# CLOUDINARY_API_SECRET=<your_api_secret>
# CALENDLY_PERSONAL_TOKEN=cal_your_personal_access_token_here (optional)
# CALENDLY_API_TOKEN=cal_your_personal_access_token_here (optional, legacy alias)
# CALENDLY_WEBHOOK_SIGNING_KEY=<your_webhook_signing_key_here> (optional)
# CALENDLY_ORG_URI=https://api.calendly.com/organizations/XXXXXXXX (optional)