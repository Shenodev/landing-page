PORT=5000
# Render will inject PORT automatically - do not hardcode in production (uses process.env.PORT)
MONGODB_URI=mongodb://localhost:27017/shenodev
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,https://shenodev.tech
FRONTEND_URL=http://localhost:3000
# In production (Vercel): FRONTEND_URL=https://shenodev.tech
RESEND_API_KEY=re_your_api_key_here
ADMIN_SECRET=your-strong-admin-secret-here
# Generate with: openssl rand -hex 32
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# For local file uploads, Cloudinary will store in folders:
# - Projects: shenodev_projects
# - Discovery attachments: shenodev_discovery
# Frontend FormData usage (see instructions below):
# const formData = new FormData();
# formData.append('image', file); // for POST /api/projects - field name "image" (or "file")
# formData.append('title', 'My Project'); // other fields as text
# // For discovery with file:
# formData.append('attachment', file); // field "attachment" or "file" - will be uploaded to shenodev_discovery
# Production (pending DNS for shenodev.tech):
# ALLOWED_ORIGINS=https://shenodev.tech
# NEXT_PUBLIC_API_URL=https://api.shenodev.tech
# EXPO_PUBLIC_API_URL=https://api.shenodev.tech
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/shenodev?retryWrites=true&w=majority
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
