NEXT_PUBLIC_API_URL=http://localhost:5000
# Calendly scheduling link - set your REAL event type URL once you create it in Calendly
# (e.g. https://calendly.com/YOUR_USERNAME/your-event-type). Leave unset and the
# discovery page shows a "scheduling link not configured" notice instead.
# NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/YOUR_USERNAME/your-event-type
